# Runtime
APP_ENV=development
APP_TIMEZONE=Europe/Kyiv
ENABLE_SCHEDULER=true
POLL_INTERVAL_SECONDS=300
INTERNAL_JOB_TOKEN=change-me

# Google Sheets / Calendar / Gmail
GOOGLE_AUTH_MODE=oauth
GOOGLE_SHEET_ID=replace-with-google-sheet-id
GOOGLE_CALENDAR_ID=primary
GOOGLE_USER_ID=me
GOOGLE_CLIENT_SECRET_FILE=secrets/google-oauth-client.json
GOOGLE_TOKEN_FILE=secrets/google-token.json
GOOGLE_SERVICE_ACCOUNT_FILE=secrets/google-service-account.json
GOOGLE_DELEGATED_USER=
GOOGLE_SCOPES=https://www.googleapis.com/auth/calendar.readonly,https://www.googleapis.com/auth/tasks,https://www.googleapis.com/auth/gmail.readonly,https://www.googleapis.com/auth/spreadsheets

# Matching and transcript lookup
CALENDAR_TITLE_KEYWORDS=Vegas
CALENDAR_LOOKBACK_HOURS=48
CALENDAR_LOOKAHEAD_MINUTES=90
# Робочий день у APP_TIMEZONE, лише будні. Поза вікном цикл не працює:
# зустрічей немає, тож опитувати календар і пошту немає сенсу.
# Бот прокидається на CALENDAR_LOOKAHEAD_MINUTES раніше, щоб нагадування
# для зустрічі на самому початку дня встигло вийти.
WORK_HOURS_START=10
WORK_HOURS_END=19
GMAIL_TRANSCRIPT_SENDER=
GMAIL_TRANSCRIPT_LABEL=
GMAIL_TRANSCRIPT_QUERY=

# Telegram Bot API
TELEGRAM_BOT_TOKEN=replace-with-bot-token
TELEGRAM_SEND_EMPTY_FOLLOWUP=false
# Pre-meeting reminders go to whoever runs the 1:1, not to the manager.
HOST_TELEGRAM_CHAT_ID=
HOST_TELEGRAM_THREAD_ID=
# Every spelling of the 1:1 host, comma separated: transcripts and the
# Ukrainian follow-ups name the same person differently.
HOST_NAME=
# How many past follow-ups feed the pre-meeting reminder.
REMINDER_FOLLOWUP_COUNT=6
# Exactly one process may poll the bot (Telegram returns 409 to the rest).
ENABLE_TELEGRAM_BOT=true
# Meeting summaries are drafted for manual review before sending.
SUMMARY_AUTO_SEND=false

# LLM
LLM_PROVIDER=gemini
GEMINI_API_KEY=replace-with-gemini-api-key
# Ланцюжок від найпотужнішої до простішої: новіші Flash часто віддають 503
# під навантаженням, і бот сповзає на наступну замість того, щоб упасти.
GEMINI_MODEL=gemini-3.8-flash,gemini-3.6-flash,gemini-3.5-flash
OPENAI_API_KEY=replace-with-api-key
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=
LLM_MAX_TRANSCRIPT_CHARS=60000

# Optional fallback if Managers tab is empty. Prefer the Managers tab for production.
# Format: [{"manager_id":"alpha","manager_name":"Alpha","aliases":["Alpha"],"telegram_chat_id":""}]
DEFAULT_MANAGERS_JSON=[]

